{
  "db_name": "PostgreSQL",
  "query": "SELECT\n                transaction_hash as \"transaction_hash!\",\n                sender_wc as \"sender_wc!\",\n                sender_account as \"sender_account!\",\n                recipient_wc as \"recipient_wc!\",\n                recipient_account as \"recipient_account!\",\n                ticker as token_symbol,\n                target_token_root_wc as token_address_wc,\n                target_token_root_account as token_address_account,\n                value as \"amount!\",\n                status::TEXT as \"status!\",\n                created_at as \"created_at!\"\n            FROM token_transfers\n            WHERE ($1::INT IS NULL OR sender_wc = $1)\n                AND ($2::TEXT IS NULL OR sender_account = $2)\n            ORDER BY\n                CASE WHEN $4::BOOL THEN created_at END ASC,\n                CASE WHEN NOT $4::BOOL THEN created_at END DESC,\n                transaction_hash\n            LIMIT $3 OFFSET $5",
